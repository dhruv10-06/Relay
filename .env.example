# ==============================================================================
# RELAY Environment Configuration Template
# Copy this file to .env in the root or server directory
# ==============================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Database Configuration (Optional)
# If provided, RELAY connects to MongoDB Atlas.
# If omitted or unreachable, RELAY automatically uses persistent local JSON storage.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/relay_db?retryWrites=true&w=majority

# AI Service Configuration (Optional)
# If provided, RELAY analyzes documents using live LLM APIs.
# If omitted, RELAY runs in High-Fidelity Deterministic Demo Mode with zero external dependencies.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Optional: Groq or Gemini API Configuration
# GROQ_API_KEY=
